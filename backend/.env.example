# ==============================================================================
# Medicine AI — Backend Environment Configuration Template
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Security & Upload Validation
MAX_UPLOAD_SIZE_MB=15

# Allowed CORS Origins (comma-separated origins, or * for open development)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8080

# Database Configuration (Placeholders — Provide real credentials when configuring database)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medicine_db
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# Direct Database URL (Optional override; if set, overrides individual DB_* variables)
# Examples:
# PostgreSQL: postgresql+psycopg2://postgres:your_db_password_here@localhost:5432/medicine_db
# SQLite (local dev): sqlite:///./medicine.db
DATABASE_URL=

# EasyOCR Language & Hardware Settings
OCR_LANGUAGES=en
OCR_USE_GPU=false
